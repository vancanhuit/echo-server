# Copy to .env; mise loads it for all tasks. These settings disable the two
# upstream features that expose local environment variables and filesystem data.
PORT=8080
LOGS_LEVEL=info
ENABLE_ENVIRONMENT=false
ENABLE_FILE=false

# Optional Echo middleware; all disabled unless explicitly configured.
# MIDDLEWARE_GZIP=true
# MIDDLEWARE_SECURE=true
# MIDDLEWARE_TIMEOUT=65s
# MIDDLEWARE_CORS_ORIGINS=http://localhost:3000
# MIDDLEWARE_RATELIMIT_RATE=20
# MIDDLEWARE_RATELIMIT_BURST=30
