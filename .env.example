# Copy to .env; mise loads it for all tasks. These settings disable the two
# upstream features that expose local environment variables and filesystem data.
PORT=8080
LOGS__LEVEL=info
ENABLE__ENVIRONMENT=false
ENABLE__FILE=false

# Optional Echo middleware; all disabled unless explicitly configured.
# MIDDLEWARE__GZIP=true
# MIDDLEWARE__SECURE=true
# MIDDLEWARE__TIMEOUT=65s
# MIDDLEWARE__CORS__ORIGINS=http://localhost:3000
# MIDDLEWARE__RATELIMIT__RATE=20
# MIDDLEWARE__RATELIMIT__BURST=30
